# Підключення до PostgreSQL
DATABASE_URL=postgres://localhost/vudo_erp
# Порт API (у розробці інтерфейс працює на 5173 і проксує /api сюди)
PORT=3000
# development | production
NODE_ENV=development
# У production за HTTPS — true (cookie лише по HTTPS). За замовчуванням true в production.
# COOKIE_SECURE=true
# Кількість проксі перед сервером (nginx = 1), щоб бачити справжній IP клієнта
TRUST_PROXY=0
# Скільки днів живе сесія без активності
SESSION_DAYS=30
# Папка для файлів замовлень (резервне копіювання — разом із БД)
UPLOAD_DIR=uploads
